<Page
    x:Class="Calculator.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Calculator.Core.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Style x:Key="BodyTextBlockMediumStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Style x:Key="BodyTextBlockMediumStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Style x:Key="BodyTextBlockMediumStyle" TargetType="TextBlock" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="BackgroundShade"
            Grid.Row="1"
            Margin="0,-1,0,0"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource SolidBackgroundFillColorBase}"
            BorderBrush="{ThemeResource SystemControlForegroundChromeHighBrush}"
            BorderThickness="1"
            CornerRadius="0.2" />

        <Grid x:Name="HistoryListRootGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="HistoryEmptyNotice"
                Margin="12,8,24,0"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="No history available"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ListView
                x:Name="HistoryListView"
                Grid.Row="0"
                MinHeight="60"
                Margin="4,0"
                Padding="0,24,0,0"
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="HistoryListView_ItemClick"
                ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                SelectionMode="None"
                TabIndex="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryModel">
                        <StackPanel Margin="0,6,16,6" Background="Transparent">
                            <TextBlock
                                x:Name="ExprTextBlock"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Right"
                                AutomationProperties.AccessibilityView="Raw"
                                AutomationProperties.AutomationId="HistoryItemExpression"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource BodyTextBlockMediumStyle}"
                                Text="{x:Bind Expression}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ResultTextBlock"
                                HorizontalAlignment="Right"
                                AutomationProperties.AccessibilityView="Raw"
                                AutomationProperties.AutomationId="HistoryItemValue"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Result}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="HistoryCopy_Click"
                                        Icon="Copy"
                                        Text="复制" />
                                    <MenuFlyoutItem
                                        Click="HistoryDelete_Click"
                                        Icon="Delete"
                                        Text="删除" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="ClearHistoryButton"
                Grid.Row="1"
                Margin="10,0,3,10"
                HorizontalAlignment="Right"
                Click="ClearHistory_Click"
                Visibility="Visible">
                <FontIcon Glyph="&#xE74D;" />
            </Button>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="DockedLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryListRootGrid.(Grid.Row)" Value="0" />
                        <Setter Target="HistoryListRootGrid.(Grid.RowSpan)" Value="2" />
                        <Setter Target="HistoryListView.Padding" Value="0" />
                        <Setter Target="BackgroundShade.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DefaultLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
