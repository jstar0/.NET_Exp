<Page
    x:Class="NotePadSharp.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NotePadSharp.Behaviors"
    xmlns:behaviors1="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:NotePadSharp.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            Margin="10,0,0,0"
            Padding="0,10,0,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Image
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                Source="/Assets/WindowIcon.ico" />
            <TextBlock
                x:Name="AppTitleBarText"
                Margin="28,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap" />
        </Grid>

        <Grid Grid.Row="1">
            <controls:TabbedCommandBar
                x:Name="TabbedCommandBar"
                Canvas.ZIndex="0"
                IsBackButtonVisible="Auto"
                IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                IsSettingsVisible="True"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
                <controls:TabbedCommandBar.AutoSuggestBox>
                    <AutoSuggestBox AutomationProperties.Name="Search" QueryIcon="Find" />
                </controls:TabbedCommandBar.AutoSuggestBox>
                <controls:TabbedCommandBar.PaneFooter>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton
                            Command="{x:Bind ViewModel.OnFileOpen}"
                            Icon="{ui:FontIcon Glyph=&#xE8E5;}"
                            Label="Open" />
                        <AppBarButton
                            Command="{x:Bind ViewModel.OnFileSave}"
                            Icon="{ui:FontIcon Glyph=&#xE74E;}"
                            Label="Save" />
                        <AppBarButton
                            Command="{x:Bind ViewModel.OnNewFile}"
                            Icon="{ui:FontIcon Glyph=&#xE7C3;}"
                            Label="New" />
                        <AppBarButton
                            Command="{x:Bind ViewModel.OnShare}"
                            Icon="{ui:FontIcon Glyph=&#xE72D;}"
                            Label="Share" />
                    </CommandBar>
                </controls:TabbedCommandBar.PaneFooter>
                <controls:TabbedCommandBar.MenuItems>
                    <controls:TabbedCommandBarItem x:Name="TabbedCommandBarHome" Header="Home">
                        <AppBarButton
                            x:Name="UndoButton"
                            Command="{x:Bind ViewModel.OnUndo}"
                            Icon="{ui:FontIcon Glyph=&#xE7A7;}"
                            Label="Undo" />
                        <AppBarButton
                            x:Name="RedoButton"
                            Command="{x:Bind ViewModel.OnRedo}"
                            Icon="{ui:FontIcon Glyph=&#xE7A6;}"
                            Label="Redo" />
                        <AppBarButton
                            Command="{x:Bind ViewModel.OnPaste}"
                            Icon="{ui:FontIcon Glyph=&#xE77F;}"
                            Label="Paste" />
                        <AppBarSeparator />
                        <AppBarElementContainer>
                            <controls:ColorPickerButton
                                x:Name="ColorPickerButton"
                                IsTabStop="False"
                                SelectedColor="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                        </AppBarElementContainer>
                        <AppBarElementContainer>
                            <ComboBox
                                x:Name="FontComboBox"
                                MinWidth="175"
                                ItemsSource="{x:Bind ViewModel.SystemFonts}"
                                SelectionChanged="FontComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{Binding Source}" Text="{Binding Source}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </AppBarElementContainer>
                        <AppBarElementContainer>
                            <TextBox
                                x:Name="FontSizeTxtBox"
                                PlaceholderText="Size"
                                TextChanged="FontSizeTxtBox_OnTextChanged" />
                        </AppBarElementContainer>
                        <AppBarToggleButton
                            x:Name="BoldToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Bold"
                            Icon="{ui:FontIcon Glyph=&#xE8DD;}"
                            IsChecked="{x:Bind ViewModel.IsBold, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarToggleButton
                            x:Name="ItalicToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Italic"
                            Icon="{ui:FontIcon Glyph=&#xE8DB;}"
                            IsChecked="{x:Bind ViewModel.IsItalic, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarToggleButton
                            x:Name="UnderlineToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Underline"
                            Icon="{ui:FontIcon Glyph=&#xE8DC;}"
                            IsChecked="{x:Bind ViewModel.IsUnderline, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarToggleButton
                            x:Name="StrikethroughToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Strikethrough"
                            Icon="{ui:FontIcon Glyph=&#xEDE0;}"
                            IsChecked="{x:Bind ViewModel.IsStrikethrough, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarSeparator />
                        <AppBarToggleButton
                            x:Name="AlignLeftToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Align Left"
                            Icon="{ui:FontIcon Glyph=&#xE8E4;}"
                            IsChecked="{x:Bind ViewModel.IsAlignLeft, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarToggleButton
                            x:Name="AlignCenterToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Align Center"
                            Icon="{ui:FontIcon Glyph=&#xE8E3;}"
                            IsChecked="{x:Bind ViewModel.IsAlignCenter, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                        <AppBarToggleButton
                            x:Name="AlignRightToggleButton"
                            Width="40"
                            muxc:ToolTipService.ToolTip="Align Right"
                            Icon="{ui:FontIcon Glyph=&#xE8E2;}"
                            IsChecked="{x:Bind ViewModel.IsAlignRight, Mode=TwoWay}"
                            LabelPosition="Collapsed" />
                    </controls:TabbedCommandBarItem>
                    <controls:TabbedCommandBarItem x:Name="TabbedCommandBarInsert" Header="Insert">
                        <AppBarButton
                            Icon="Pictures"
                            IsEnabled="False"
                            Label="Pictures">
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Icon="{ui:FontIcon Glyph=&#xEC4E;}" Text="This device" />
                                    <MenuFlyoutItem Icon="{ui:FontIcon Glyph=&#xE721;}" Text="Stock images" />
                                    <MenuFlyoutItem Icon="{ui:FontIcon Glyph=&#xE774;}" Text="Online pictures" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xF156;}"
                            IsEnabled="False"
                            Label="Shapes" />
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xED58;}"
                            IsEnabled="False"
                            Label="Icons" />
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xF158;}"
                            IsEnabled="False"
                            Label="3D Models" />
                        <AppBarSeparator />
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xECAA;}"
                            IsEnabled="False"
                            Label="Add-ins" />
                        <controls:TabbedCommandBarItem.SecondaryCommands>
                            <AppBarButton
                                Icon="{ui:FontIcon Glyph=&#xE710;}"
                                IsEnabled="False"
                                Label="New item" />
                        </controls:TabbedCommandBarItem.SecondaryCommands>
                    </controls:TabbedCommandBarItem>
                    <controls:TabbedCommandBarItem
                        x:Name="PictureFormat"
                        Header="Picture Format"
                        IsContextual="True"
                        Visibility="{x:Bind ContextualItem, Mode=OneWay}">
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xE706;}"
                            IsEnabled="False"
                            Label="Remove background" />
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xF4A5;}"
                            IsEnabled="False"
                            Label="Picture effects" />
                        <AppBarButton
                            Icon="{ui:FontIcon Glyph=&#xE7AD;}"
                            IsEnabled="False"
                            Label="Rotate" />
                        <AppBarElementContainer>
                            <muxc:SplitButton>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE7A8;" />
                                    <TextBlock FontSize="12" Text="Crop" />
                                </StackPanel>
                                <muxc:SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Icon="{ui:FontIcon Glyph=&#xE7A8;}" Text="Crop" />
                                        <MenuFlyoutItem Icon="{ui:FontIcon Glyph=&#xF407;}" Text="Crop to Shape" />
                                        <MenuFlyoutItem Text="Aspect Ratio" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Fill" />
                                        <MenuFlyoutItem Text="Fit" />
                                    </MenuFlyout>
                                </muxc:SplitButton.Flyout>
                            </muxc:SplitButton>
                        </AppBarElementContainer>
                    </controls:TabbedCommandBarItem>
                </controls:TabbedCommandBar.MenuItems>
            </controls:TabbedCommandBar>
            <Grid
                Margin="10,100,10,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <InfoBar
                    MaxWidth="480"
                    Margin="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Canvas.ZIndex="10">
                    <i:Interaction.Behaviors>
                        <behaviors1:StackedNotificationsBehavior x:Name="NotificationQueue" />
                    </i:Interaction.Behaviors>
                </InfoBar>
                <Frame x:Name="NavigationFrame" Canvas.ZIndex="5" />
            </Grid>
        </Grid>
    </Grid>
</Page>
